# Paper matplotlib style that matches the site (Basel: ink and one spot green). In a notebook:
#   import matplotlib.pyplot as plt
#   plt.style.use("portfolio.mplstyle")
figure.facecolor: efede6
axes.facecolor: efede6
savefig.facecolor: efede6
savefig.transparent: False
figure.dpi: 110
savefig.dpi: 200
figure.figsize: 8, 4.5
figure.constrained_layout.use: True

font.family: sans-serif
font.sans-serif: Archivo, Helvetica Neue, Arial, DejaVu Sans
font.size: 11
text.color: 0c0c0c

axes.edgecolor: 0c0c0c
axes.linewidth: 1.2
axes.labelcolor: 33322e
axes.titlecolor: 0c0c0c
axes.titlesize: 13
axes.titleweight: bold
axes.titlelocation: left
axes.titlepad: 12
axes.labelpad: 8
axes.spines.top: False
axes.spines.right: False
axes.spines.left: False
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
axes.prop_cycle: cycler('color', ['00934f', '0c0c0c', '1d5bff', 'eda100', 'e87ba4', '6250d6', 'e34948'])

grid.color: dedbd2
grid.linewidth: 0.8
xtick.color: 0c0c0c
ytick.color: 0c0c0c
xtick.labelcolor: 33322e
ytick.labelcolor: 33322e
ytick.left: False

lines.linewidth: 2
lines.markersize: 7
patch.edgecolor: none
legend.frameon: False
legend.labelcolor: 33322e
