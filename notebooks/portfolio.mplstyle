# Paper matplotlib style that matches the site. In a notebook:
#   import matplotlib.pyplot as plt
#   plt.style.use("portfolio.mplstyle")
figure.facecolor: fbfaf8
axes.facecolor: fbfaf8
savefig.facecolor: fbfaf8
savefig.transparent: False
figure.dpi: 110
savefig.dpi: 200
figure.figsize: 8, 4.5
figure.constrained_layout.use: True

font.family: sans-serif
font.sans-serif: Archivo, Helvetica Neue, Arial, DejaVu Sans
font.size: 11
text.color: 111111

axes.edgecolor: 111111
axes.linewidth: 1.2
axes.labelcolor: 3d3c39
axes.titlecolor: 111111
axes.titlesize: 13
axes.titleweight: bold
axes.titlelocation: left
axes.titlepad: 12
axes.labelpad: 8
axes.spines.top: False
axes.spines.right: False
axes.spines.left: False
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
axes.prop_cycle: cycler('color', ['2340ff', 'eb6834', '1baf7a', 'eda100', 'e87ba4', '008300', '6250d6', 'e34948'])

grid.color: e2e0da
grid.linewidth: 0.8
xtick.color: 111111
ytick.color: 111111
xtick.labelcolor: 3d3c39
ytick.labelcolor: 3d3c39
ytick.left: False

lines.linewidth: 2
lines.markersize: 7
patch.edgecolor: none
legend.frameon: False
legend.labelcolor: 3d3c39
